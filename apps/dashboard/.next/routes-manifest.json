{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/api/agents/status/[id]",
      "regex": "^/api/agents/status/([^/]+?)(?:/)?$",
      "routeKeys": { "nxtPid": "nxtPid" },
      "namedRegex": "^/api/agents/status/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/agents/[id]",
      "regex": "^/api/agents/([^/]+?)(?:/)?$",
      "routeKeys": { "nxtPid": "nxtPid" },
      "namedRegex": "^/api/agents/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/plugins/[id]",
      "regex": "^/api/plugins/([^/]+?)(?:/)?$",
      "routeKeys": { "nxtPid": "nxtPid" },
      "namedRegex": "^/api/plugins/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    { "page": "/", "regex": "^/(?:/)?$", "routeKeys": {}, "namedRegex": "^/(?:/)?$" },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/agents",
      "regex": "^/agents(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/agents(?:/)?$"
    },
    {
      "page": "/ai-providers",
      "regex": "^/ai\\-providers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ai\\-providers(?:/)?$"
    },
    {
      "page": "/governance",
      "regex": "^/governance(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/governance(?:/)?$"
    },
    {
      "page": "/infrastructure",
      "regex": "^/infrastructure(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/infrastructure(?:/)?$"
    },
    {
      "page": "/knowledge-graph",
      "regex": "^/knowledge\\-graph(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/knowledge\\-graph(?:/)?$"
    },
    {
      "page": "/observability",
      "regex": "^/observability(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/observability(?:/)?$"
    },
    {
      "page": "/openshift",
      "regex": "^/openshift(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/openshift(?:/)?$"
    },
    {
      "page": "/security",
      "regex": "^/security(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/security(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    },
    {
      "page": "/vmware",
      "regex": "^/vmware(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/vmware(?:/)?$"
    },
    {
      "page": "/workflows",
      "regex": "^/workflows(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/workflows(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc"
  },
  "rewrites": []
}
